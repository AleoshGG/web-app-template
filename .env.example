# ─── Next.js ──────────────────────────────────────────────────────────────────
# The public URL where the app is accessible (used for absolute URL generation).
# On Railway, set this to your Railway-provided domain or custom domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# ─── Database (Optional - see GuideLines.md) ───────────────────────────────────
# If you add a database (PostgreSQL + Prisma) following GuideLines.md,
# uncomment and configure your connection string:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
